<?xml version="1.0" encoding="utf-8"?>
<index version="1" name="reapack-pablito">
  <metadata>
    <description><![CDATA[
Repositório pessoal de scripts e plugins para o REAPER por pablito331.
Inclui ReaScripts em Lua e Python, e plugins JSFX em EEL2.

Categorias:
- Scripts/Lua/Track    : Automação de tracks
- Scripts/Lua/Items    : Manipulação de media items
- Scripts/Lua/MIDI     : Edição e geração MIDI
- Scripts/Lua/Projeto  : Utilitários de projeto
- Scripts/Lua/UI       : Interfaces gráficas (ReaImGui / gfx)
- Scripts/Lua/Drum     : Setup e sequenciador de bateria

Scripts Python:
- project_info.py        : Exibir informações do projeto
- batch_rename_from_csv.py : Renomear tracks via CSV

Plugins JSFX:
- Audio: gain_stereo, compressor_simple
- MIDI: midi_transpose, midi_velocity_map
- Util: peak_meter

PLUGINS DE REFERÊNCIA:
- Examples/: Plugins do Tukan, Cockos e outros criadores para estudo
- Drum Samplers: Loop Sampler, Granular Loop Sampler, Super8
    ]]></description>
  </metadata>

  <!-- ============================================================ -->
  <!--  SCRIPTS LUA – Drum                                          -->
  <!-- ============================================================ -->

  <category name="Scripts/Lua/Drum">
    <reapack name="pablito_luadrummer.lua" type="script" desc="Setup de bateria e sequenciador">
      <metadata>
        <description><![CDATA[Setup automatizado de bateria com download de kits .rpk, sequenciador para criar ritmos e export MIDI. Por pablito331. Inclui UI gráfica com gfx, leitura de kits instalados, sequenciador 4/8 compassos x 16 passos.]]></description>
      </metadata>
      <version name="1.0" author="pablito331" time="2026-09-08T00:00:00Z">
        <changelog><![CDATA[Versão inicial com UI, leitura de kits, sequenciador e export MIDI]]></changelog>
        <source file="pablito_luadrummer.lua">https://github.com/pablito331/reapack-pablito/raw/master/Scripts/Lua/pablito_luadrummer.lua</source>
      </version>
    </reapack>
  </category>

